{
  "name": "voice-survey-enumerator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "kobo:test": "./scripts/kobo_submit.sh",
    "smoke:parse": "tsx scripts/smoke-parse.ts",
    "smoke:receipt": "tsx scripts/smoke-receipt.ts",
    "test": "npm run -s smoke && npm run -s smoke:parse && npm run -s smoke:receipt",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3",
    "vite": "^7.0.0"
  }
}